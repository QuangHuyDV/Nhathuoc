@model IEnumerable<Nhathuoc.Models.Supplier>

@{
    ViewData["Title"] = "Supplier List";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container">
    <h2>Supplier List</h2>
    <a asp-action="Create" class="btn btn-primary mb-2">Tạo nhà cung cấp</a>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Tên nhà cung cấp</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Địa chỉ</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SupplierName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-sm btn-warning">Chỉnh sửa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
