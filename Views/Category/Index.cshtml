@model IEnumerable<Nhathuoc.Models.Category>

@{
    ViewData["Title"] = "Category List";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container">
    <h2>Thể loại</h2>
    <a asp-action="Create" class="btn btn-primary mb-2">Tạo thể loại</a>
    <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
        <div class="input-group">
            <input type="text" id="keyword" class="form-control" name="keyword" placeholder="Search learner" />
            <button class="btn btn-primary" type="button" id="btnSearch">
                <i class="fa fa-search"></i>
            </button>
        </div>
    </form>
    <table id="example" class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Mã thể loại</th>
                <th>Tên thể loại</th>
                <th>Mô tả</th>
                <th>Ngày tạo</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CategoryId</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Created</td>
                    <td>
                        <a asp-action="Update" asp-controller="Category" asp-route-id="@item.CategoryId"
                            class="btn btn-sm btn-warning">Sửa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.pageNum; i++)
        {
            <li class="page-item @(ViewBag.currentPage == i ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-mid="@ViewBag.mid" asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</div>
