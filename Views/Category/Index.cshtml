@model IEnumerable<Nhathuoc.Models.Category>

@{
    ViewData["Title"] = "Category List";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container">
    <h2>Thể loại</h2>
    <a asp-action="Create" class="btn btn-primary mb-2">Tạo thể loại</a>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Mã thể loại</th>
                <th>Tên thể loại</th>
                <th>Mô tả</th>
                <th>Ngày tạo</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CategoryId</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Created</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning">Sửa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>