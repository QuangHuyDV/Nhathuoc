@model IEnumerable<Nhathuoc.Models.Product>

@{
    ViewData["Title"] = "Product List";
}

<div class="container">
    <h2>Product List</h2>
    <a asp-action="Create" class="btn btn-primary mb-2">Create New Product</a>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Manufacturer</th>
                <th>Price</th>
                <th>Expiry Date</th>
                <th>Category</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Manufacturer</td>
                    <td>@item.Price</td>
                    <td>@item.ExpiryDate.ToShortDateString()</td>
                    <td>@item.Category.Name</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
