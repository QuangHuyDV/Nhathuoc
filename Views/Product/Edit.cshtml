@model Nhathuoc.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="container">
    <h2>Chỉnh sửa sản phầm</h2>

    <form asp-action="Edit" method="post" asp-route-id="@Model.ProductId">
        <input type="hidden" asp-for="ProductId" />

        <div class="form-group">
            <label for="Name">Tên sản phầm</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="Manufacturer">Nhà sản xuất</label>
            <input asp-for="Manufacturer" class="form-control" />
            <span asp-validation-for="Manufacturer" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="Price">Giá</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="ExpiryDate">Hạn sử dụng</label>
            <input asp-for="ExpiryDate" type="text" class="form-control" />
            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="CategoryId">Loại</label>
            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Xác nhận</button>
        <a asp-action="Index" class="btn btn-secondary">Huỷ</a>
    </form>
</div>
